# =========================
# Flask + Ganache configuration
# =========================

# Ganache RPC URL
RPC_URL=http://127.0.0.1:7545

# -------------------------
# Local mode (recommended)
# -------------------------
# If running Ganache locally and you DON'T want to depend on PRIVATE_KEY,
# you can leave ACCOUNT_ADDRESS/PRIVATE_KEY unset.
# The app will automatically fallback to w3.eth.accounts[0].

# ACCOUNT_ADDRESS=0xYOUR_ADDRESS_HERE
# PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# -------------------------
# Production mode
# -------------------------
# In production/testnet/mainnet, set a real PRIVATE_KEY.
# If PRIVATE_KEY is set, the app can derive the corresponding address.

# ACCOUNT_ADDRESS can be omitted, but if provided it must match PRIVATE_KEY.

# -------------------------
# Optional tx settings
# -------------------------
TX_GAS=600000
# TX_GAS_PRICE_WEI=20000000000
# TX_MAX_PRIORITY_FEE_WEI=2000000000

# -------------------------
# Flask config
# -------------------------
SECRET_KEY=dev-secret-key-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

